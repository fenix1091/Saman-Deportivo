rules_version = '2';

// Reglas de seguridad de Samán Deportivo.
// Hacen cumplir en el servidor lo mismo que la guardia de rutas en la app:
// cada usuario solo lee y edita su perfil, nadie puede darse otro rol y
// solo el administrador gestiona los datos deportivos.
// Pruebas: pruebas_reglas/ (npm test, con el emulador de Firestore).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function rutaUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }
    function rol() {
      return get(rutaUsuario(request.auth.uid)).data.rol;
    }
    function tienePerfil() {
      return autenticado() && exists(rutaUsuario(request.auth.uid));
    }
    function esAdmin() {
      return tienePerfil() && rol() == 'administrador';
    }
    function esEntrenador() {
      return tienePerfil() && rol() == 'entrenador';
    }
    // RN-01 (CU-08): solo un estudiante activo y solvente puede reservar un cupo.
    // La solvencia la marca la Coordinación de Deportes y el estudiante no puede cambiarla.
    function esEstudianteHabilitado() {
      let perfil = get(rutaUsuario(request.auth.uid)).data;
      return tienePerfil() && perfil.rol == 'estudiante' && perfil.estado == 'activo' && perfil.solvente == true;
    }
    function rutaDeporte(codigo) {
      return /databases/$(database)/documents/deportes/$(codigo);
    }
    function rutaInscripcion(id) {
      return /databases/$(database)/documents/inscripciones/$(id);
    }
    function rutaPago(id) {
      return /databases/$(database)/documents/pagos/$(id);
    }
    // RN-05: una reserva pendiente de pago vence a los 15 minutos.
    function vencida(inscripcion) {
      return request.time > inscripcion.fechaInscripcion + duration.value(15, 'm');
    }

    // ---------- Usuarios (RF-01, RF-02, RF-03) ----------
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin() || esEntrenador());
      allow list: if esAdmin() || esEntrenador();

      // El registro público solo admite estudiantes; el administrador puede crear entrenadores.
      allow create: if (autenticado()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rol', 'cedula', 'nombre', 'correo', 'telefono', 'fotoUrl',
                                                    'carnet', 'estado', 'solvente', 'carrera', 'creadoEn'])
          && request.resource.data.rol == 'estudiante'
          && request.resource.data.estado == 'activo'
          && request.resource.data.solvente == false
          && request.resource.data.correo == request.auth.token.email
          && request.resource.data.creadoEn == request.time)
        || (esAdmin()
          && request.resource.data.keys().hasOnly(['rol', 'cedula', 'nombre', 'correo', 'telefono', 'fotoUrl',
                                                    'especialidad', 'aniosExperiencia'])
          && request.resource.data.keys().hasAll(['rol', 'cedula', 'nombre', 'correo', 'telefono', 'fotoUrl',
                                                   'especialidad', 'aniosExperiencia'])
          && request.resource.data.rol == 'entrenador'
          && request.resource.data.cedula is string
          && request.resource.data.nombre is string
          && request.resource.data.correo is string
          && request.resource.data.telefono is string
          && request.resource.data.fotoUrl is string
          && request.resource.data.especialidad is string
          && request.resource.data.aniosExperiencia is int
          && request.resource.data.aniosExperiencia >= 0);

      // Perfil: el dueño solo cambia teléfono y foto; el administrador, todo.
      allow update: if esAdmin()
        || (autenticado()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telefono', 'fotoUrl'])
          && request.resource.data.telefono is string
          && request.resource.data.telefono.size() <= 20
          && request.resource.data.fotoUrl is string
          && request.resource.data.fotoUrl.size() < 1000000);

      allow delete: if esAdmin();
    }

    // Índices de unicidad: un documento por cédula y por carnet. Se crean en el
    // mismo lote que el usuario y no se pueden sobrescribir, así que una cédula
    // o un carnet repetidos hacen fallar el registro.
    match /cedulas/{cedula} {
      allow get: if autenticado();
      allow create: if (autenticado()
          && request.resource.data.uid == request.auth.uid
          && getAfter(rutaUsuario(request.auth.uid)).data.cedula == cedula)
        || (esAdmin()
          && getAfter(rutaUsuario(request.resource.data.uid)).data.rol == 'entrenador'
          && getAfter(rutaUsuario(request.resource.data.uid)).data.cedula == cedula);
      allow delete: if esAdmin();
    }
    match /carnets/{carnet} {
      allow get: if autenticado();
      allow create: if autenticado()
        && request.resource.data.uid == request.auth.uid
        && getAfter(rutaUsuario(request.auth.uid)).data.carnet == carnet;
      allow delete: if esAdmin();
    }

    // ---------- Estructura base de la gestión deportiva ----------
    // El catálogo es público; solo el administrador lo modifica (RF-04, RF-15, RF-17).
    // Cualquiera puede sumar 1 al contador de consultas para las estadísticas de
    // deportes más buscados (postcondición de CU-04), y nada más.
    match /deportes/{codigo} {
      allow read: if true;
      allow write: if esAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vecesBuscado'])
        && request.resource.data.vecesBuscado == resource.data.get('vecesBuscado', 0) + 1;
      // RF-08 y RNF-05: el estudiante solo suma 1 cupo, sin pasar del máximo, y solo en la
      // misma transacción que confirma su inscripción pagada (RN-02, RN-06).
      allow update: if autenticado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cuposOcupados'])
        && request.resource.data.cuposOcupados == resource.data.get('cuposOcupados', 0) + 1
        && request.resource.data.cuposOcupados <= resource.data.cupoMaximo
        && get(rutaInscripcion(codigo + '_' + request.auth.uid)).data.estado == 'pendientePago'
        && getAfter(rutaInscripcion(codigo + '_' + request.auth.uid)).data.estado == 'confirmada';
      // CU-10: al cancelar una inscripción confirmada se libera su cupo, solo en la
      // misma transacción en la que pasa a cancelada. Una reserva pendiente de pago
      // no ocupaba cupo (RN-06), así que al cancelarla no se libera ninguno.
      allow update: if autenticado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cuposOcupados'])
        && request.resource.data.cuposOcupados == resource.data.get('cuposOcupados', 0) - 1
        && get(rutaInscripcion(codigo + '_' + request.auth.uid)).data.estado == 'confirmada'
        && getAfter(rutaInscripcion(codigo + '_' + request.auth.uid)).data.estado == 'cancelada';
      match /horarios/{id} {
        allow read: if true;
        allow write: if esAdmin();
      }
    }

    // ---------- Inscripción, cupos y pago (RF-07, RF-08, RF-09) ----------
    // El id es {codigo}_{uid}: un estudiante tiene un solo documento por deporte (RN-03).
    match /inscripciones/{id} {
      function esDueno() {
        return autenticado() && resource.data.estudianteId == request.auth.uid;
      }
      function cambia(campos) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
      }
      // CU-07, paso 4: reserva en PENDIENTE_PAGO si está habilitado y queda cupo.
      function reservaValida() {
        let datos = request.resource.data;
        let deporte = get(rutaDeporte(datos.deporteCodigo)).data;
        return esEstudianteHabilitado()
          && id == datos.deporteCodigo + '_' + request.auth.uid
          && datos.keys().hasOnly(['estudianteId', 'deporteCodigo', 'fechaInscripcion', 'estado', 'motivo', 'pagoId'])
          && datos.estudianteId == request.auth.uid
          && datos.estado == 'pendientePago'
          && datos.fechaInscripcion == request.time
          && datos.pagoId == ''
          && deporte.activo == true
          && deporte.get('entrenadorId', '') != ''
          && deporte.get('cuposOcupados', 0) < deporte.cupoMaximo;
      }

      allow read: if esAdmin() || esEntrenador() || esDueno();

      allow create: if reservaValida();
      // Volver a reservar después de cancelar, de un rechazo o de una reserva vencida.
      allow update: if reservaValida()
        && (resource.data.estado in ['cancelada', 'rechazada', 'expirada']
          || (resource.data.estado == 'pendientePago' && vencida(resource.data)));

      // CU-07, paso 6: se confirma con un pago completado y ocupando un cupo, todo junto.
      allow update: if esDueno()
        && resource.data.estado == 'pendientePago'
        && !vencida(resource.data)
        && cambia(['estado', 'pagoId'])
        && request.resource.data.estado == 'confirmada'
        && getAfter(rutaPago(request.resource.data.pagoId)).data.inscripcionId == id
        && getAfter(rutaPago(request.resource.data.pagoId)).data.estado == 'completado'
        && getAfter(rutaDeporte(resource.data.deporteCodigo)).data.cuposOcupados
          == get(rutaDeporte(resource.data.deporteCodigo)).data.get('cuposOcupados', 0) + 1;

      // CU-07, A5: rechazada solo si de verdad ya no queda cupo.
      allow update: if esDueno()
        && resource.data.estado == 'pendientePago'
        && cambia(['estado', 'motivo'])
        && request.resource.data.estado == 'rechazada'
        && get(rutaDeporte(resource.data.deporteCodigo)).data.get('cuposOcupados', 0)
          >= get(rutaDeporte(resource.data.deporteCodigo)).data.cupoMaximo;

      // RN-05: el propio estudiante marca como expirada su reserva vencida.
      allow update: if esDueno()
        && resource.data.estado == 'pendientePago'
        && vencida(resource.data)
        && cambia(['estado', 'motivo'])
        && request.resource.data.estado == 'expirada';

      // CU-10: el estudiante cancela su inscripción vigente.
      allow update: if esDueno()
        && resource.data.estado in ['pendientePago', 'confirmada']
        && cambia(['estado'])
        && request.resource.data.estado == 'cancelada';

      allow write: if esAdmin();
    }

    // Trazabilidad del pago (RF-09): solo se guarda la referencia de PayPal, nunca la
    // tarjeta (RNF-03). El id es {idInscripcion}_{milisegundos} y no se puede editar.
    match /pagos/{id} {
      function inscripcionDelPago() {
        return request.resource.data.inscripcionId;
      }
      allow read: if esAdmin()
        || (autenticado() && resource.data.inscripcionId.split('_')[1] == request.auth.uid);
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['inscripcionId', 'monto', 'moneda', 'metodo', 'referenciaExterna',
                                                  'fecha', 'estado'])
        && inscripcionDelPago().split('_')[1] == request.auth.uid
        && id.matches(inscripcionDelPago() + '_[0-9]+')
        && request.resource.data.fecha == request.time
        && request.resource.data.referenciaExterna is string
        && request.resource.data.referenciaExterna.size() > 0
        && request.resource.data.monto == get(rutaDeporte(inscripcionDelPago().split('_')[0])).data.costoReserva
        && ((request.resource.data.estado == 'completado'
            && getAfter(rutaInscripcion(inscripcionDelPago())).data.estado == 'confirmada'
            && getAfter(rutaInscripcion(inscripcionDelPago())).data.pagoId == id)
          || (request.resource.data.estado == 'reembolsado'
            && getAfter(rutaInscripcion(inscripcionDelPago())).data.estado == 'rechazada'));
      allow update, delete: if esAdmin();
    }

    // Asistencias y reseñas se abren cuando se programen sus módulos (RF-13, RF-15).
    match /asistencias/{id} {
      allow read, write: if esAdmin();
    }
    // Reseñas (CU-12): una por estudiante y deporte, solo si está inscrito.
    match /resenas/{id} {
      allow read: if true;
      allow create, update: if autenticado()
        && id == request.resource.data.deporteCodigo + '_' + request.auth.uid
        && request.resource.data.estudianteId == request.auth.uid
        && request.resource.data.keys().hasOnly(['estudianteId', 'autor', 'deporteCodigo', 'calificacion', 'comentario', 'fecha'])
        && request.resource.data.get('autor', '') is string
        && request.resource.data.get('autor', '').size() <= 80
        && request.resource.data.calificacion is int
        && request.resource.data.calificacion >= 1
        && request.resource.data.calificacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 500
        && get(rutaInscripcion(id)).data.estado == 'confirmada';
      allow delete: if esAdmin();
    }
  }
}
