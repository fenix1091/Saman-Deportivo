@startuml
!include _estilo.iuml
title Diagrama de clases de diseño — módulo de autenticación y perfil
skinparam classAttributeIconSize 0
hide empty members

package "models" {
  enum Rol {
    estudiante
    entrenador
    administrador
  }
  abstract class Persona {
    + uid : String
    + cedula : String
    + nombre : String
    + correo : String
    + telefono : String
    + fotoUrl : String
    + {abstract} rol : Rol
    + {abstract} copiarPerfil(telefono, fotoUrl) : Persona
    + aMapa() : Map
    + {static} desdeMapa(uid, mapa) : Persona
  }
  class Estudiante {
    + carnet : String
    + estado : EstadoEstudiante
    + solvente : bool
    + carrera : String
    + estaActivo() : bool
  }
  class Entrenador {
    + especialidad : String
    + aniosExperiencia : int
  }
  class Administrador {
    + cargo : String
  }
}

package "repositories" {
  interface AuthRepository <<interfaz>> {
    + usuarioActual : Persona
    + cambiosDeSesion : Stream<Persona>
    + registrarEstudiante(cedula, nombre, correo, carnet, clave) : Estudiante
    + iniciarSesion(correo, clave) : Persona
    + enviarRecuperacionClave(correo) : void
    + cerrarSesion() : void
    + actualizarPerfil(usuario) : Persona
    + subirFotoPerfil(uid, bytes, extension) : String
  }
  class AuthRepositoryLocal {
    + {static} maxIntentos = 5
    - usuarios : Map
    - intentosFallidos : Map
    + {static} conDatosDePrueba() : AuthRepositoryLocal
  }
  class AuthRepositoryFirebase <<pendiente>>
  enum ErrorAuth {
    credencialesInvalidas
    correoYaRegistrado
    cedulaYaRegistrada
    carnetYaRegistrado
    demasiadosIntentos
    sinConexion
    desconocido
    + mensaje : String
  }
  class AuthException {
    + error : ErrorAuth
  }
}

package "viewmodels" {
  class ChangeNotifier <<Flutter>>
  class AuthViewModel {
    + usuario : Persona
    + haySesion : bool
    + cargando : bool
    + error : ErrorAuth
    + registrar(...) : bool
    + iniciarSesion(correo, clave) : bool
    + recuperarClave(correo) : bool
    + cerrarSesion() : void
    + {static} rutaInicio(rol) : String
  }
  class PerfilViewModel {
    + {static} tamanoMaximoFoto = 2 MB
    + fotoNueva : bytes
    + guardando : bool
    + error : String
    + elegirFoto(bytes, nombreArchivo) : bool
    + guardar(telefono) : bool
  }
}

Persona <|-- Estudiante
Persona <|-- Entrenador
Persona <|-- Administrador
Persona ..> Rol
AuthRepository <|.. AuthRepositoryLocal
AuthRepository <|.. AuthRepositoryFirebase
AuthRepository ..> AuthException : lanza
AuthException --> ErrorAuth
AuthRepository ..> Persona
ChangeNotifier <|-- AuthViewModel
ChangeNotifier <|-- PerfilViewModel
AuthViewModel --> "1" AuthRepository
PerfilViewModel --> "1" AuthRepository
@enduml
