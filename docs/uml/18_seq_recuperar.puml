@startuml
!include _estilo.iuml
title Diagrama de secuencia — CU-02 A3 Recuperar contraseña
autonumber
actor "Usuario" as U
boundary ":RecuperarClaveView" as V
control ":AuthViewModel" as VM
participant ":AuthRepository" as R
participant "Firebase Auth" as FA

U -> V : pulsa "¿Olvidaste tu contraseña?"
U -> V : escribe su correo y pulsa "Enviar enlace"
V -> V : Validadores.correo()
V -> VM : recuperarClave(correo)
VM -> R : enviarRecuperacionClave(correo)
R -> FA : sendPasswordResetEmail(correo)
FA --> R : ok (exista o no la cuenta)
R --> VM : ok
VM --> V : enviado
V --> U : "Si el correo tiene una cuenta,\nte enviamos un enlace"
note right of V
  No se confirma si el correo existe,
  para no revelar qué cuentas hay.
end note
@enduml
