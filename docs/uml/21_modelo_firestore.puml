@startuml
!include _estilo.iuml
title Modelo de datos en Cloud Firestore (colecciones y documentos)
skinparam classAttributeIconSize 0
hide empty members
hide circle

class "usuarios/{uid}" as U {
  rol : "estudiante" | "entrenador" | "administrador"
  cedula : string
  nombre : string
  correo : string
  telefono : string
  fotoUrl : string
  .. solo estudiante ..
  carnet : string
  estado : "activo" | "inactivo"
  solvente : bool
  carrera : string
  .. solo entrenador ..
  especialidad : string
  aniosExperiencia : number
  .. solo administrador ..
  cargo : string
}
class "deportes/{codigo}" as D {
  nombre : string
  descripcion : string
  categoria : string
  cupoMaximo : number
  cuposOcupados : number
  costoReserva : number
  imagenUrl : string
  entrenadorId : string
  activo : bool
  vecesBuscado : number
}
class "deportes/{codigo}/horarios/{id}" as H {
  dia : string
  horaInicio : string
  horaFin : string
  lugar : string
}
class "inscripciones/{id}" as I {
  estudianteId : string
  deporteCodigo : string
  fechaInscripcion : timestamp
  estado : "PENDIENTE_PAGO" | "CONFIRMADA" |
  "CANCELADA" | "RECHAZADA" | "EXPIRADA"
}
class "pagos/{id}" as P {
  inscripcionId : string
  monto : number
  moneda : string
  referenciaPaypal : string
  fecha : timestamp
  estado : string
}
class "asistencias/{id}" as A {
  inscripcionId : string
  estudianteId : string
  deporteCodigo : string
  fecha : date
  estado : "PRESENTE" | "AUSENTE"
  observacion : string
}
class "resenas/{id}" as R {
  estudianteId : string
  deporteCodigo : string
  calificacion : 1..5
  comentario : string
  fecha : timestamp
}

D *-- H
U <.. D : entrenadorId
U <.. I : estudianteId
D <.. I : deporteCodigo
I <.. P : inscripcionId
I <.. A : inscripcionId
U <.. R : estudianteId
D <.. R : deporteCodigo

note top of U
  El id del documento es el uid de
  Firebase Auth (implementado en el Hito 2).
end note
@enduml
