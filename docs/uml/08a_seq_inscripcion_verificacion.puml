@startuml
!include _estilo.iuml
title Diagrama de secuencia — CU-07 Inscribirse en un deporte (a) Verificación
autonumber
actor "Estudiante" as E
boundary ":DetalleDeporteView" as V
control ":InscripcionViewModel" as VM
participant ":InscripcionRepository" as R
database "Cloud Firestore" as FS
participant "Cloud Functions" as CF

E -> V : pulsa "Inscribirme"
V -> VM : inscribirse(deporteId)
VM -> R : obtenerDeporte(deporteId)
R -> FS : get(deportes/deporteId)
FS --> R : deporte {cupoMaximo, cuposOcupados}
R --> VM : deporte
alt no hay cupos disponibles
  VM --> V : "No hay cupos disponibles"
  V --> E : muestra mensaje y sugiere otros deportes
else hay cupo
  VM -> CF : validarSolvencia(carnet)
  CF -> FS : get(usuarios/estudianteId)
  FS --> CF : {estado, solvente}
  alt inactivo o no solvente
    CF --> VM : rechazado(motivo)
    VM --> V : "No cumples los requisitos: <motivo>"
    V --> E : muestra mensaje
  else activo y solvente
    CF --> VM : aprobado
    VM -> R : crearInscripcion(estudiante, deporte)
    R -> FS : add(inscripciones, estado=PENDIENTE_PAGO)
    FS --> R : inscripcionId
    R --> VM : inscripcionId
    VM --> V : mostrar resumen del pago
    V --> E : pantalla "Confirmar inscripción"
  end
end
note over E, CF
  Continúa en (b) Pago y confirmación
end note
@enduml
