@startuml
!include _estilo.iuml
title Diagrama de secuencia — CU-01 Registrarse
autonumber
actor "Estudiante" as U
boundary ":RegistroView" as V
participant ":Validadores" as VAL
control ":AuthViewModel" as VM
participant ":AuthRepository" as R
participant "Firebase Auth" as FA
database "Cloud Firestore" as FS

U -> V : ingresa cédula, nombre, correo,\ncarnet y contraseña
U -> V : pulsa "Crear cuenta"
V -> VAL : validar cada campo
alt algún campo inválido
  VAL --> V : mensajes de error
  V --> U : marca los campos y explica el formato (A1)
else datos válidos
  V -> VM : registrar(datos)
  VM -> VM : normalizarCedula()
  VM -> R : registrarEstudiante(datos)
  R -> FA : createUserWithEmailAndPassword()
  alt correo ya registrado
    FA --> R : email-already-in-use
    R --> VM : AuthException(correoYaRegistrado)
    V --> U : "Ya existe una cuenta" + Iniciar sesión /\nRecuperar contraseña (A2)
  else cuenta creada
    FA --> R : User(uid)
    R -> FS : escritura en lote: usuarios/uid,\ncedulas/{cedula}, carnets/{carnet}
    alt cédula o carnet ya registrados
      FS --> R : rechazada por las reglas (el índice existe)
      R -> FA : delete() del usuario recién creado
      R --> VM : AuthException(cedula/carnetYaRegistrado)
      V --> U : "Ya existe una cuenta" + opciones (A2)
    else guardado
      R -> FA : sendEmailVerification()
      R --> VM : Estudiante
      VM --> V : registro exitoso
      V --> U : aviso de verificación y /catalogo
    end
  end
end
@enduml
